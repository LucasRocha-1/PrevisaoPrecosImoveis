<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PrevisaoPrecosImoveis.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- ML.NET - regressão, classificação, clustering (compatível com certificações de ML) -->
    <PackageReference Include="Microsoft.ML" Version="3.0.1" />
    <PackageReference Include="Microsoft.ML.FastTree" Version="3.0.1" />
    <PackageReference Include="Microsoft.ML.AutoML" Version="0.21.1" />
    
    <!-- Análise e pré-processamento de dados -->
    <PackageReference Include="Microsoft.Data.Analysis" Version="0.21.1" />
    
    <!-- Leitura de Excel (FipeZap, ITBI SP) -->
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    
    <!-- HTTP client e serialização -->
    <PackageReference Include="System.Net.Http.Json" Version="8.0.1" />
    
    <!-- Logging -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

</Project>
